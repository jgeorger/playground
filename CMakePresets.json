{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Ninja Multi-Config",
            "description": "Single build tree producing Release, Debug, and RelWithDebInfo configurations",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release;Debug;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "Release",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "all",
            "displayName": "All Configurations",
            "description": "Build Release, Debug, and RelWithDebInfo",
            "configurePreset": "default"
        },
        {
            "name": "release",
            "displayName": "Release Build",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "displayName": "Debug Build",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo Build",
            "configurePreset": "default",
            "configuration": "RelWithDebInfo"
        }
    ],
    "testPresets": [
        {
            "name": "release",
            "displayName": "Release Tests",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "displayName": "Debug Tests",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo Tests",
            "configurePreset": "default",
            "configuration": "RelWithDebInfo"
        }
    ]
}
